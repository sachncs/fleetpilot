{
  "name": "vehicle-routing",
  "version": "1.1.0",
  "description": "VRP-RPD solver for Indian logistics: route optimization with ALNS + BRKGA metaheuristics, time windows, multi-depot, and traffic-aware routing",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "vrp-solver": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "samples/"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rm -rf dist docs/api docs/md",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "pretest": "npm run build",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "pretest:coverage": "npm run build",
    "test:coverage": "c8 mocha",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage",
    "docs": "typedoc",
    "docs:md": "typedoc --plugin typedoc-plugin-markdown --out docs/md",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.d.ts",
      "src/**/*.test.ts",
      "tests/**",
      "dist/**",
      "demo/**"
    ],
    "check-coverage": true,
    "lines": 85,
    "functions": 85,
    "branches": 70,
    "statements": 85
  },
  "keywords": [
    "vrp",
    "vehicle-routing",
    "route-optimization",
    "logistics",
    "last-mile",
    "delivery",
    "alns",
    "brkga",
    "metaheuristic",
    "optimization"
  ],
  "author": "Sachin <sachncs@gmail.com>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/sachncs/vehicle-routing-problem-with-resource-constraints.git"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "12.3.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.21",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "c8": "10.1.3",
    "chai": "6.2.2",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "^64.0.2",
    "mocha": "11.7.6",
    "rollup": "4.62.0",
    "rollup-plugin-dts": "6.4.1",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.1.0"
  }
}
